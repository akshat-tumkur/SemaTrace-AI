# Copy to .env.cloud; keep that file private. Never use a paid/trial compute plan.
SEMATRACE_STORAGE_PROVIDER=supabase
SEMATRACE_VECTOR_PROVIDER=pinecone
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Dashboard Connect > Transaction pooler (IPv4), SSL required; URL-encode password.
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=sematrace-private
PINECONE_API_KEY=
PINECONE_INDEX_NAME=sematrace-minilm
PINECONE_INDEX_HOST=
SEMATRACE_INFERENCE_BATCH_SIZE=8
SEMATRACE_WRITE_REQUESTS_PER_MINUTE=10
SEMATRACE_PINECONE_TOP_K=256
# Distinct passage fingerprints across global/private libraries and history.
SEMATRACE_CLOUD_MAX_PASSAGES=20000
SEMATRACE_SOURCE_UPLOAD_ENABLED=true
SEMATRACE_SERVE_FRONTEND=false
SEMATRACE_CORS_ORIGINS=https://YOUR_PROJECT.vercel.app
SEMATRACE_ALLOWED_HOSTS=YOUR_SERVICE.onrender.com,localhost,127.0.0.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=
# External calls are disabled until both user/global budgets are explicitly set.
SEMATRACE_AI_USER_DAILY_LIMIT=0
SEMATRACE_AI_GLOBAL_DAILY_LIMIT=0
SEMATRACE_WEB_USER_DAILY_LIMIT=0
SEMATRACE_WEB_GLOBAL_DAILY_LIMIT=0
SEMATRACE_ANALYSIS_USER_DAILY_LIMIT=10
SEMATRACE_ANALYSIS_GLOBAL_DAILY_LIMIT=30
SEMATRACE_REFERENCE_USER_DAILY_LIMIT=3
SEMATRACE_REFERENCE_GLOBAL_DAILY_LIMIT=10
