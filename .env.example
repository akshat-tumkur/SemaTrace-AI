# Optional external services. Each upload has visible AI/web choices.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=

# Local CPU retrieval and private source uploads.
SEMATRACE_EMBEDDING_PROVIDER=local-onnx
SEMATRACE_PERSISTENT_RETRIEVAL_ENABLED=true
SEMATRACE_IMPORT_LEGACY_CORPUS=false
SEMATRACE_SOURCE_UPLOAD_ENABLED=true
SEMATRACE_LOCAL_MODEL_DIR=
SEMATRACE_CORPUS_DB_PATH=
SEMATRACE_CORS_ORIGINS=http://127.0.0.1:8010,http://localhost:8010,http://localhost:5173
SEMATRACE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend,sematrace
SEMATRACE_WRITE_REQUESTS_PER_MINUTE=60
# Set an explicit report path only when overriding native defaults.
# SEMATRACE_DB_PATH=/private/sematrace/analyses.sqlite3

# Optional private experimental reranker; not required for ordinary use.
SEMATRACE_REVIEW_MODEL_DIR=
SEMATRACE_INVESTIGATION_ENABLED=false
